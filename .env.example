# ==============================================================================
# Supabase PostgreSQL Configuration for Listmonk
# ==============================================================================

# Supabase Database Host (Pooler in Session mode):
LISTMONK_DB_HOST=aws-0-eu-west-1.pooler.supabase.com

# Database Port (Session mode):
LISTMONK_DB_PORT=5432

# Database User:
LISTMONK_DB_USER=postgres.your-project-ref

# Database Password (set when creating your Supabase project):
LISTMONK_DB_PASSWORD=your_supabase_db_password

# Database Name:
LISTMONK_DB_NAME=postgres

# SSL Mode (Supabase mandates SSL; keep as require):
LISTMONK_DB_SSL_MODE=require

# Optional: Initial Super Admin Setup
# If set before the first run, Listmonk automatically creates this super admin account.
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=change_this_password
